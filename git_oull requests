from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from typing import List
from app.config.database import get_db
from app.infrastructure.models.patient_alert import PatientAlert
from app.domain.schemas.patient_alert_schemas import PatientAlertCreate, PatientAlertResponse
from app.infrastructure.auth.supabase_auth import verify_supabase_token
from app.infrastructure.repositories.user_repository import UserRepository
router = APIRouter(prefix="/api/patient-alerts", tags=["Patient Alerts"])
@router.post("", response_model=PatientAlertResponse, status_code=status.HTTP_201_CREATED)
def create_alert(
    alert_data: PatientAlertCreate,
    db: Session = Depends(get_db),
    token_data: dict = Depends(verify_supabase_token)
):
    """
    Crea una nueva alerta para el paciente autenticado.
    (Usado por la app móvil cuando el PEF cae en zona roja o amarilla).
    """
    user_repo = UserRepository(db)
    user = user_repo.get_by_supabase_uid(token_data["sub"])
    if not user:
        raise HTTPException(status_code=404, detail="Usuario no encontrado")
        
    new_alert = PatientAlert(
        user_id=user.id,
        pef_value=alert_data.pef_value,
        risk_level=alert_data.risk_level
    )
    db.add(new_alert)
    db.commit()
    db.refresh(new_alert)
    return new_alert
@router.get("/patient/{patient_id}", response_model=List[PatientAlertResponse])
def get_patient_alerts(
    patient_id: int,
    db: Session = Depends(get_db),
    token_data: dict = Depends(verify_supabase_token)
):
    """
    Obtiene todas las alertas generadas por un paciente específico.
    (Usado por el dashboard de Angular para el doctor).
    """
    alerts = db.query(PatientAlert).filter(PatientAlert.user_id == patient_id).order_by(PatientAlert.created_at.desc()).all()
    return alerts
@router.patch("/{alert_id}/view", response_model=PatientAlertResponse)
def mark_alert_as_viewed(
    alert_id: int,
    db: Session = Depends(get_db),
    token_data: dict = Depends(verify_supabase_token)
):
    """
    Marca una alerta como vista por el doctor.
    (Usado por el dashboard de Angular).
    """
    alert = db.query(PatientAlert).filter(PatientAlert.id == alert_id).first()
    if not alert:
        raise HTTPException(status_code=404, detail="Alerta no encontrada")
        
    alert.is_viewed_by_doctor = True
    db.commit()
    db.refresh(alert)
    return alert
